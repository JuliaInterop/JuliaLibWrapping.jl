flowchart TD
    Import["<b>import pkg</b>"] --> Init["<b>__init__.py</b> runs first"]

    Init -->|"Linux/macOS, bundled"| Rpath["<b>_lowlevel.py</b><br/>ctypes.CDLL(bundle/lib/libmylib.*)<br/>RUNPATH already resolves libjulia:<br/>$ORIGIN/../lib[/julia] (Linux)<br/>@loader_path/../lib* (macOS)"]

    Init -->|"Windows, bundled"| DllDir["<b>__init__.py</b> preamble<br/>os.add_dll_directory(bundle/bin)<br/>PATH-prepend fallback if unavailable"]
    DllDir --> WinBundleLoad["<b>_lowlevel.py</b><br/>ctypes.CDLL(bundle/bin/mylib.dll)"]

    Init -->|"Windows, flat (no bundle)"| FindJulia["<b>_lowlevel.py</b>: _find_julia_bin()<br/>JULIA_BINDIR &rarr; JULIA_PREFIX &rarr;<br/>shutil.which(julia) &rarr; julia -e Sys.BINDIR"]
    FindJulia --> WidenPath["widen DLL search path only:<br/>os.add_dll_directory(julia_bin)<br/>or PATH-prepend fallback"]
    WidenPath --> WinFlatLoad["ctypes.CDLL(mylib.dll)<br/>beside the package"]

    style Import fill:#e3f2fd,stroke:#1565c0,color:#0d2440
    style Init fill:#e3f2fd,stroke:#1565c0,color:#0d2440
    style Rpath fill:#e8f5e9,stroke:#2e7d32,color:#0d2440
    style DllDir fill:#fff3e0,stroke:#e65100,color:#0d2440
    style WinBundleLoad fill:#e8f5e9,stroke:#2e7d32,color:#0d2440
    style FindJulia fill:#fff3e0,stroke:#e65100,color:#0d2440
    style WidenPath fill:#fff3e0,stroke:#e65100,color:#0d2440
    style WinFlatLoad fill:#e8f5e9,stroke:#2e7d32,color:#0d2440
