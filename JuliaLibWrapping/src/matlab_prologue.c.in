/* Auto-generated by JuliaLibWrapping. Do not edit by hand. */
#ifndef _GNU_SOURCE
#define _GNU_SOURCE  /* dladdr */
#endif
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include <fcntl.h>
#include "mex.h"
#include "@TYPES_HEADER@"

/* Where the shared library is, in the order the loader tries:
   the environment variable, then this MEX file's own directory,
   then the path `build_mex.m` compiled in. The relative one is
   what lets a built package be moved or downloaded, since the
   layout it names is the one this target emits. A bare name
   would resolve against MATLAB's working directory instead. */
#ifndef JLW_LIBRARY_PATH
#define JLW_LIBRARY_PATH "@LIBRARY_BASENAME@"
#endif
#define JLW_LIBRARY_RELATIVE "@LIBRARY_RELATIVE@"
#define JLW_LIBRARY_ENV "@LIBRARY_ENV@"

static void *jlw_library = NULL;

/* Julia's runtime marks inherited pipes non-blocking and leaves
   them that way, which MATLAB's own reads then see as errors.
   It bites when MATLAB runs under -batch in a pipeline. */
typedef struct { int flags[3]; } jlw_stdio_flags;

static jlw_stdio_flags jlw_save_stdio(void)
{
    jlw_stdio_flags saved;
    for (int fd = 0; fd < 3; fd++) {
        saved.flags[fd] = fcntl(fd, F_GETFL);
    }
    return saved;
}

static void jlw_restore_stdio(jlw_stdio_flags saved)
{
    for (int fd = 0; fd < 3; fd++) {
        if (saved.flags[fd] != -1) {
            fcntl(fd, F_SETFL, saved.flags[fd]);
        }
    }
}

/* The directory holding this MEX file, so the library can be found
   beside it wherever the package was put. */
static void jlw_own_directory(char *out, size_t size)
{
    Dl_info info;
    out[0] = '\0';
    if (dladdr((void *)jlw_own_directory, &info) == 0 ||
        info.dli_fname == NULL) {
        return;
    }
    snprintf(out, size, "%s", info.dli_fname);
    char *slash = strrchr(out, '/');
    if (slash == NULL) {
        out[0] = '\0';
        return;
    }
    *slash = '\0';
}

/* Local: every entry point is reached through this handle, and the
   runtime finds its own image from the address of the caller, so
   nothing here needs the global scope. Loading it globally would
   publish this library's unversioned names -- the entry points,
   `jlw_free`, the image symbols -- where a second wrapped library
   would find them. */
static void *jlw_open(const char *base)
{
    char path[4096];
#ifdef __APPLE__
    snprintf(path, sizeof path, "%s.dylib", base);
#else
    snprintf(path, sizeof path, "%s.so", base);
#endif
    return dlopen(path, RTLD_LAZY | RTLD_NODELETE);
}

/* Opened once and never closed. Nothing releases this reference, so
   `clear mex` leaves the library mapped and the next load finds it
   rather than running `jl_init` a second time. */
static void *jlw_symbol(const char *name)
{
    if (jlw_library == NULL) {
        jlw_stdio_flags saved = jlw_save_stdio();
        const char *override = getenv(JLW_LIBRARY_ENV);
        char own[4096];
        char beside[4096];
        beside[0] = '\0';
        jlw_own_directory(own, sizeof own);
        if (own[0] != '\0') {
            snprintf(beside, sizeof beside, "%s/" JLW_LIBRARY_RELATIVE, own);
        }
        if (override != NULL) {
            jlw_library = jlw_open(override);
        }
        if (jlw_library == NULL && beside[0] != '\0') {
            jlw_library = jlw_open(beside);
        }
        if (jlw_library == NULL) {
            jlw_library = jlw_open(JLW_LIBRARY_PATH);
        }
        if (jlw_library == NULL) {
            const char *message = dlerror();
            mexErrMsgIdAndTxt("jlw:library",
                "could not load %s (%s); set " JLW_LIBRARY_ENV
                " to its path without the extension",
                JLW_LIBRARY_PATH, message ? message : "");
        }
        jlw_restore_stdio(saved);
    }
    void *address = dlsym(jlw_library, name);
    if (address == NULL) {
        mexErrMsgIdAndTxt("jlw:library", "missing entry point %s", name);
    }
    return address;
}
